SHELL = /bin/sh

CC = @CC@
CXX = @CXX@
CFLAGS = @LFUN_CFLAGS@
CXXFLAGS = @LFUN_CXXFLAGS@
INCS = @INCS@
LIBS = @LIBS@
JOBS = @JOBS@
SHLIB_EXT = @SHLIB_EXT@
SHLIB_LDFLAGS = @SHLIB_LDFLAGS@
RPATH_FLAGS = @RPATH_FLAGS@

MAKEFLAGS+=-j$(JOBS)

SOURCE_DIRS = src
BUILD_DIRS = $(patsubst %, build/%, $(SOURCE_DIRS)) build/test build/examples $(patsubst %, build/%/test, $(SOURCE_DIRS))
AT=@
define NEWLINE


endef

export

HEADERS = $(wildcard include/*.h)
SOURCES = $(wildcard $(patsubst %, %/*.c, $(SOURCE_DIRS)))
OBJS = $(patsubst %.c, build/%.o, $(SOURCES))


EXECUTABLES_SOURCES = $(wildcard examples/*.c) $(wildcard examples/*.cpp)
EXECUTABLES = $(patsubst %.c, build/%.exe, $(wildcard examples/*.c)) $(patsubst %.cpp, build/%.exe, $(wildcard examples/*.cpp))
TEST_SOURCES = $(wildcard test/*.c) $(wildcard test/*.cpp)
TESTS = $(patsubst %.c, build/%.exe, $(wildcard test/*.c)) $(patsubst %.cpp, build/%.exe, $(wildcard test/*.cpp))

all: $(OBJS) test lib executables

clean:
	rm -rf build


executables: $(EXECUTABLES)

test: $(TESTS)

lib: build/liblfun.$(SHLIB_EXT)

build/liblfun.$(SHLIB_EXT): $(OBJS) $(HEADERS) | build_dirs
	$(CC) $(CFLAGS) $(SHLIB_LDFLAGS) $(INCS) $(OBJS) -o $@ $(LIBS)

build/%.o: %.c $(HEADERS) | build_dirs
	$(CC) $(CFLAGS) $(INCS) -c $< -o $@;

build/%.o: %.cpp $(HEADERS) | build_dirs
	$(CXX) $(CXXFLAGS) $(INCS) -c $< -o $@;

$(TESTS) : %.exe : %.o $(OBJS)
	$(CXX) $(CXXFLAGS) $(INCS) $^ -o $@ $(LIBS) $(RPATH_FLAGS)

build/%.valgrind : %.c $(SOURCES)
	$(CC) $(CFLAGS) $(INCS) $^ -o $@ $(LIBS)

build/%.valgrind : %.cpp $(SOURCES)
	$(CXX) $(CXXFLAGS) $(INCS) $^ -o $@ $(LIBS)

$(EXECUTABLES) : %.exe : %.o $(OBJS)
	$(CXX) $(CXXFLAGS) $(INCS) $^ -o $@ $(LIBS) $(RPATH_FLAGS)

# Regenerate the committed ./configure from configure.ac (maintainers; needs autoconf).
# Phony so `make configure` always regenerates when requested.
configure:
	autoreconf -i

build_dirs: $(BUILD_DIRS)

$(BUILD_DIRS): % :
	mkdir -p $@


print-%:
	@echo '$*=$($*)'

.PHONY: clean check configure

# Regression suite. Exit code is the oracle (assertions are on by default).
# Stale/colliding g_<mu> caches poison results, so scrub them before the suite
# and after each binary (different L-functions can share a g_<mu> filename).
#
# Every test/ and examples/ binary runs under `make check` automatically --
# drop in a new source file and it joins the suite, no edit here required.
# CHECK_EXCLUDE is the deny-list: binaries that require command-line arguments
# or input files (they assert on argc / print a usage message and exit nonzero
# without args) and so cannot run unattended. Only add an entry here if a
# binary needs arguments. (artin runs an embedded self-test when given none.)
CHECK_EXCLUDE = \
	examples/bound \
	examples/rational

CHECK_BINS = $(filter-out $(addprefix build/, $(addsuffix .exe, $(CHECK_EXCLUDE))), $(TESTS) $(EXECUTABLES))

check: all
	@rm -f g_[0-9]*
	@fail=0; \
	for t in $(CHECK_BINS); do \
	  printf 'RUN  %s\n' "$$t"; \
	  if ./$$t >$$t.log 2>&1; then printf 'PASS %s\n' "$$t"; rm -f $$t.log; \
	  else rc=$$?; printf 'FAIL %s (rc=%s)\n' "$$t" "$$rc"; cat $$t.log; rm -f $$t.log; fail=1; fi; \
	  rm -f g_[0-9]*; \
	done; \
	if [ $$fail -ne 0 ]; then echo 'CHECK FAILED'; exit 1; fi; \
	echo 'CHECK PASSED'
